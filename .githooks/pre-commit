#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ ! -x "$REPO_ROOT/scripts/check-api-package.sh" ]; then
  echo "[pre-commit] ERROR: scripts/check-api-package.sh is not executable" >&2
  echo "Run: chmod +x ./scripts/check-api-package.sh" >&2
  exit 1
fi

echo "[pre-commit] Checking API package sync..."
"$REPO_ROOT/scripts/check-api-package.sh"
